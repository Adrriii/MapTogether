{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitReturns": true,
		"exactOptionalPropertyTypes": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["bun-types"],
		"paths": {
			"@mtg-shared/*":    ["./src/shared/*"],
			"@mtg-companion/*": ["./src/companion/*"],
			"@mtg-server/*":    ["./src/server/*"],
			"@quaver-ipc/*":    ["./src/quaver_ipc/*"],
			"@lib/*":    ["./src/lib/*"],
			"@root/*":   ["./*"]
		}
	},
	"include": ["src/**/*.ts", "scripts/*.ts", "*.ts"]
}
